<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/yellow_soft" />
            <stroke android:width="2dp" android:color="@color/accent_blue" />
            <corners android:radius="16dp" />
            <padding android:left="16dp" android:top="9dp" android:right="16dp" android:bottom="9dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/yellow_soft" />
            <stroke android:width="2dp" android:color="@color/accent_blue" />
            <corners android:radius="16dp" />
            <padding android:left="16dp" android:top="9dp" android:right="16dp" android:bottom="9dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/yellow_soft" />
            <stroke android:width="2dp" android:color="@color/border_strong" />
            <corners android:radius="16dp" />
            <padding android:left="16dp" android:top="9dp" android:right="16dp" android:bottom="9dp" />
        </shape>
    </item>
</selector>
