<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CUOIKY_QLLICHHOCTAP" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/mali_regular</item>
        <item name="fontFamily">@font/mali_regular</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="colorPrimary">@color/ink</item>
        <item name="colorSecondary">@color/yellow</item>
        <item name="colorSurface">@color/paper_light</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="android:editTextColor">@color/input_text</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="alertDialogTheme">@style/StudyAlertDialog</item>
        <item name="android:colorAccent">@color/rose</item>
    </style>

    <style name="StudyAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:fontFamily">@font/mali_regular</item>
        <item name="fontFamily">@font/mali_regular</item>
        <item name="android:colorBackground">@color/paper_light</item>
        <item name="android:textColorPrimary">@color/dialog_text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="colorPrimary">@color/ink</item>
        <item name="colorSurface">@color/paper_light</item>
    </style>

    <style name="StudyInput">
        <item name="android:fontFamily">@font/mali_regular</item>
        <item name="android:textColor">@color/input_text</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">false</item>
    </style>

    <style name="StudySpinner">
        <item name="android:fontFamily">@font/mali_regular</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:popupBackground">@color/paper_light</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/input_text</item>
    </style>

    <style name="StudyCheck">
        <item name="android:fontFamily">@font/mali_regular</item>
        <item name="android:background">@drawable/bg_check_option</item>
        <item name="android:buttonTint">@color/mint</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="StudyReadableText">
        <item name="android:fontFamily">@font/mali_regular</item>
        <item name="fontFamily">@font/mali_regular</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
