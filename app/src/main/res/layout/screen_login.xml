<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_logo"
            android:gravity="center"
            android:rotation="-2"
            android:text="✓"
            android:textColor="@color/ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="Studygram desk"
            android:textColor="@color/rose"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_highlight_blue"
            android:paddingHorizontal="10dp"
            android:text="Đăng nhập để mở trang vở học tập"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_input"
            android:autofillHints="emailAddress"
            android:hint="Email / số điện thoại"
            android:inputType="textEmailAddress"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/inputPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:autofillHints="password"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <CheckBox
            android:id="@+id/checkRemember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:buttonTint="@color/mint"
            android:checked="true"
            android:text="Ghi nhớ đăng nhập"
            android:textColor="@color/muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/ink"
            android:text="Đăng nhập"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFakeGoogle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Đăng nhập với Google"
            android:textColor="@color/ink"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:strokeColor="@color/line" />

        <TextView
            android:id="@+id/textGoRegister"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:text="Chưa có tài khoản? Đăng ký ngay"
            android:textColor="@color/danger"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
