<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_form_panel"
        android:orientation="vertical"
        android:padding="18dp">

        <EditText
            android:id="@+id/inputTitle"
            style="@style/StudyInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_input"
            android:hint="Tên sự kiện"
            android:importantForAutofill="no"
            android:inputType="textCapSentences" />

        <Spinner
            android:id="@+id/spinnerType"
            style="@style/StudySpinner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input" />

        <EditText
            android:id="@+id/inputDate"
            style="@style/StudyInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:focusable="false"
            android:hint="Ngày"
            android:importantForAutofill="no"
            android:inputType="date" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputStart"
                style="@style/StudyInput"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:focusable="false"
                android:hint="Bắt đầu"
                android:importantForAutofill="no"
                android:inputType="time" />

            <EditText
                android:id="@+id/inputEnd"
                style="@style/StudyInput"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:focusable="false"
                android:hint="Kết thúc"
                android:importantForAutofill="no"
                android:inputType="time" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputRoom"
            style="@style/StudyInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="Phòng học / địa điểm"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/inputNote"
            style="@style/StudyInput"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="Ghi chú"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences" />

        <CheckBox
            android:id="@+id/checkReminder"
            style="@style/StudyCheck"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Bật nhắc nhở" />

        <Spinner
            android:id="@+id/spinnerReminderBefore"
            style="@style/StudySpinner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input" />
    </LinearLayout>
</ScrollView>
