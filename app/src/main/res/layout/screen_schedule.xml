<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lịch học"
        android:textColor="@color/rose"
        android:textSize="29sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textWeekRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Hôm nay"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/modeDay"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_pill"
            android:gravity="center"
            android:text="Ngày"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeThreeDays"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_pill"
            android:gravity="center"
            android:text="3 ngày"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeWeek"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_selected_pill"
            android:gravity="center"
            android:text="Tuần"
            android:textColor="@color/ink"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPrevWeek"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_outline_pill"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnThisWeek"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_selected_pill"
            android:gravity="center"
            android:text="Hôm nay"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNextWeek"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_outline_pill"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_selected_pill"
                android:gravity="center"
                android:text="Tất cả"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterStudy"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_outline_pill"
                android:gravity="center"
                android:text="Lịch học"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterExam"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_outline_pill"
                android:gravity="center"
                android:text="Thi"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterDeadline"
                android:layout_width="96dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_outline_pill"
                android:gravity="center"
                android:text="Deadline"
                android:textColor="@color/ink"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.example.cuoiky_qllichhoctap.ui.WeekCalendarView
                android:id="@+id/weekCalendar"
                android:layout_width="match_parent"
                android:layout_height="920dp" />

            <TextView
                android:id="@+id/textConflictTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Kiểm tra xung đột"
                android:textColor="@color/accent_blue"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/eventList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportImage"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/mint"
            android:text="Tạo từ ảnh"
            android:textColor="@color/ink"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddEvent"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/ink"
            android:text="Thêm lịch"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="18dp" />
    </LinearLayout>
</LinearLayout>
