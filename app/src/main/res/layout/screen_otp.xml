<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:gravity="center"
            android:text="Xác thực OTP"
            android:textColor="@color/rose"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textOtpSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Nhập mã 6 số đã gửi tới email"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textOtpEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_highlight_blue"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputOtp"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:hint="000000"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyOtp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/ink"
            android:text="Xác nhận"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResendOtp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Gửi lại mã"
            android:textColor="@color/ink"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:strokeColor="@color/line" />

        <TextView
            android:id="@+id/textBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Quay lại"
            android:textColor="@color/danger"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
