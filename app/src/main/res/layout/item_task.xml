<?xml version="1.0" encoding="utf-8"?>
<com.example.cuoiky_qllichhoctap.ui.SwipeActionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/taskActions"
        android:layout_width="232dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/btnTaskDone"
            android:layout_width="68dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_action_done"
            android:gravity="center"
            android:text="Xong"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTaskEdit"
            android:layout_width="68dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_action_edit"
            android:gravity="center"
            android:text="Sửa"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTaskDelete"
            android:layout_width="68dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_action_delete"
            android:gravity="center"
            android:text="Xóa"
            android:textColor="@color/rose"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/taskForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/checkDone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:buttonTint="@color/mint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textPriority"
            android:layout_width="72dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.example.cuoiky_qllichhoctap.ui.SwipeActionLayout>
