<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_form_panel"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mali_semibold"
        android:text="Nội dung phản ánh"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/mali_regular"
        android:lineSpacingExtra="2dp"
        android:text="Mô tả ngắn lỗi bạn gặp hoặc góp ý muốn gửi. Admin sẽ đọc trong mục Feedback &amp; lỗi."
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/inputIssueMessage"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input"
        android:fontFamily="@font/mali_regular"
        android:gravity="top|start"
        android:hint="Ví dụ: App bị lỗi khi tạo lịch học..."
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="900"
        android:minLines="5"
        android:padding="16dp"
        android:textColor="@color/input_text"
        android:textColorHint="@color/input_hint"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/mali_regular"
        android:text="Không cần ghi mật khẩu hoặc thông tin nhạy cảm."
        android:textColor="@color/muted"
        android:textSize="12sp" />
</LinearLayout>
