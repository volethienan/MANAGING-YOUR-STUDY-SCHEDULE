<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cài đặt"
            android:textColor="@color/rose"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tùy chỉnh trải nghiệm học tập"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textProfile"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_yellow"
            android:gravity="center_vertical"
            android:rotation="-1"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkNotify"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:buttonTint="@color/mint"
            android:checked="true"
            android:text="Thông báo nhắc nhở"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkSync"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:buttonTint="@color/mint"
            android:checked="true"
            android:text="Đồng bộ Google Calendar"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/mint"
            android:text="Sửa hồ sơ"
            android:textColor="@color/ink"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/coral"
            android:text="Đăng xuất"
            android:textColor="@color/ink"
            android:textStyle="bold"
            app:cornerRadius="18dp" />
    </LinearLayout>
</ScrollView>
