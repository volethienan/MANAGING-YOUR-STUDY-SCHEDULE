<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ngày đếm ngược"
                android:textColor="@color/rose"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCountdownSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tự đặt sự kiện và xem còn bao nhiêu ngày"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_logo"
            android:gravity="center"
            android:rotation="2"
            android:text="D-day"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="180dp"
        android:background="@drawable/bg_tape_pink"
        android:rotation="-2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:layout_marginTop="18dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textCountdownNearest"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_yellow"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="5"
            android:padding="12dp"
            android:rotation="-1"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCountdownOverdue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_danger_soft"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="4"
            android:padding="12dp"
            android:rotation="1"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/countdownFilterAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_selected_pill"
            android:gravity="center"
            android:text="Tất cả"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/countdownFilterUpcoming"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_pill"
            android:gravity="center"
            android:text="Sắp tới"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/countdownFilterOverdue"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_pill"
            android:gravity="center"
            android:text="Đã qua"
            android:textColor="@color/ink"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/countdownList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddCountdown"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/mint"
        android:text="Cài sự kiện đếm ngược"
        android:textColor="@color/ink"
        android:textStyle="bold"
        app:cornerRadius="18dp" />
</LinearLayout>
