<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To-Do List"
        android:textColor="@color/rose"
        android:textSize="29sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sắp xếp việc học theo deadline"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="82dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_selected_pill"
                android:gravity="center"
                android:text="Tất cả"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterToday"
                android:layout_width="82dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_outline_pill"
                android:gravity="center"
                android:text="Hôm nay"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterSoon"
                android:layout_width="82dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_outline_pill"
                android:gravity="center"
                android:text="Sắp hạn"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterOverdue"
                android:layout_width="82dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_outline_pill"
                android:gravity="center"
                android:text="Quá hạn"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/taskList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddTask"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/ink"
        android:text="Thêm công việc"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="18dp" />
</LinearLayout>
