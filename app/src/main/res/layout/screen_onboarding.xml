<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="26dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_logo"
            android:contentDescription="Checkmark logo"
            android:padding="20dp"
            android:rotation="-3"
            android:src="@drawable/ic_check"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="Study Planner"
            android:textColor="@color/rose"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_highlight_yellow"
            android:paddingHorizontal="10dp"
            android:text="LẬP KẾ HOẠCH HỌC TẬP"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Một trang vở nhỏ cho lịch học, deadline và các phiên tập trung của bạn."
            android:textColor="@color/muted"
            android:textSize="17sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:layout_marginTop="40dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="166dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_card_yellow"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:rotation="-1.5">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hôm nay học gì?"
                    android:textColor="@color/ink"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Lịch tiếp theo, việc ưu tiên và Pomodoro được dán gọn trên một trang giấy."
                    android:textColor="@color/muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="104dp"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_tape_pink"
                android:rotation="-4" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="42dp"
            android:backgroundTint="@color/accent_blue"
            android:text="Bắt đầu ghi lịch"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />
    </LinearLayout>
</ScrollView>
